# DIM-S Store Backend Environment Variables

# Database Configuration
DB_HOST=your-render-postgres-host
DB_PORT=5432
DB_NAME=dims_store
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password

# JWT Configuration
JWT_SECRET=generate-random-secure-string-min-32-chars
JWT_EXPIRE=7d

# Server Configuration
PORT=10000
NODE_ENV=production

# Mandiri Payment Configuration
MANDIRI_ACCOUNT=1420020873427
MANDIRI_ACCOUNT_NAME=DIMAS ARU SAMUDRA

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=DIM-S Store <noreply@dims-store.com>
STORE_NAME=DIM-S Store
STORE_URL=https://your-frontend-vercel-url.vercel.app

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
